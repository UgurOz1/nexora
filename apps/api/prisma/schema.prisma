generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  // Null for users who only sign in with Google.
  passwordHash    String?
  // Google's stable account id (the "sub" claim). Emails can change, this cannot.
  googleId        String?   @unique
  name            String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     Membership[]
  sentInvitations Invitation[] @relation("InvitedBy")
  assignedTasks   Task[]       @relation("TaskAssignee")
  createdTasks    Task[]       @relation("TaskCreator")
  refreshTokens   RefreshToken[]
  userTokens      UserToken[]

  @@map("users")
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Single-use tokens sent by email. Only the hash is stored, like refresh tokens.
model UserToken {
  id        String        @id @default(uuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

// One row per issued refresh token. Tokens from one login share a familyId; each refresh
// revokes the old token and issues a new one in the same family (rotation). If a revoked
// token is presented again, it was stolen: the whole family is revoked.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  familyId   String
  // SHA-256 of the token; the raw value only ever lives in the user's cookie.
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]
  tasks       Task[]

  @@map("organizations")
}

// A user's role inside one organization. A user can belong to many organizations.
model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  // Only a hash of the emailed token is stored, so a leaked database cannot be used to accept invites.
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model Project {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  // Free-form team or department this project belongs to, e.g. "Marketing".
  department     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([organizationId])
  @@map("projects")
}

model Task {
  id             String       @id @default(uuid())
  // Duplicated from the project so every tenant query can filter on organizationId directly.
  organizationId String
  projectId      String
  // Set for subtasks.
  parentId       String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  labels         String[]     @default([])
  assigneeId     String?
  createdById    String
  // Fractional index string used to order tasks inside a Kanban column (week 8).
  position       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("Subtasks")
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, projectId, status])
  @@index([organizationId, createdAt])
  @@index([assigneeId])
  @@index([parentId])
  @@map("tasks")
}
