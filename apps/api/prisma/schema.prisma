generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  // Null for users who only sign in with Google.
  passwordHash    String?
  // Google's stable account id (the "sub" claim). Emails can change, this cannot.
  googleId        String?   @unique
  name            String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships         Membership[]
  sentInvitations     Invitation[]    @relation("InvitedBy")
  assignedTasks       Task[]          @relation("TaskAssignee")
  createdTasks        Task[]          @relation("TaskCreator")
  refreshTokens       RefreshToken[]
  userTokens          UserToken[]
  taskEvents          TaskEvent[]
  assignedRecurring   RecurringTask[] @relation("RecurringAssignee")
  createdRecurring    RecurringTask[] @relation("RecurringCreator")
  comments            Comment[]       @relation("CommentAuthor")
  notifications       Notification[]  @relation("NotificationRecipient")
  causedNotifications Notification[]  @relation("NotificationActor")

  @@map("users")
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Single-use tokens sent by email. Only the hash is stored, like refresh tokens.
model UserToken {
  id        String        @id @default(uuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

// One row per issued refresh token. Tokens from one login share a familyId; each refresh
// revokes the old token and issues a new one in the same family (rotation). If a revoked
// token is presented again, it was stolen: the whole family is revoked.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  // SHA-256 of the token; the raw value only ever lives in the user's cookie.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  invitations      Invitation[]
  projects         Project[]
  tasks            Task[]
  taskDependencies TaskDependency[]
  taskEvents       TaskEvent[]
  recurringTasks   RecurringTask[]
  comments         Comment[]
  notifications    Notification[]

  @@map("organizations")
}

// A user's role inside one organization. A user can belong to many organizations.
model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  // Only a hash of the emailed token is stored, so a leaked database cannot be used to accept invites.
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model Project {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  // Free-form team or department this project belongs to, e.g. "Marketing".
  department     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]
  recurringTasks RecurringTask[]

  @@index([organizationId])
  @@map("projects")
}

model Task {
  id              String       @id @default(uuid())
  // Duplicated from the project so every tenant query can filter on organizationId directly.
  organizationId  String
  projectId       String
  // Set for subtasks.
  parentId        String?
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?
  labels          String[]     @default([])
  assigneeId      String?
  createdById     String
  // Fractional index string used to order tasks inside a Kanban column (week 8).
  position        String
  // Set on tasks generated from a recurring template; (recurringTaskId, occurrenceAt) is unique,
  // so the same occurrence can never produce two tasks, even if two workers race.
  recurringTaskId String?
  occurrenceAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks      Task[]           @relation("Subtasks")
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recurringTask RecurringTask?   @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)
  // Tasks this task waits for ("dependencies") and tasks that wait for this one ("dependents").
  dependencies  TaskDependency[] @relation("Blocked")
  dependents    TaskDependency[] @relation("Blocker")
  events        TaskEvent[]
  comments      Comment[]
  notifications Notification[]

  @@unique([recurringTaskId, occurrenceAt])
  @@index([organizationId, projectId, status])
  @@index([organizationId, createdAt])
  @@index([assigneeId])
  @@index([parentId])
  @@map("tasks")
}

// "taskId waits for dependsOnId": taskId cannot leave TODO until dependsOnId is DONE.
// The graph must stay acyclic; that is checked in the service, under a per-organization lock.
model TaskDependency {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  dependsOnId    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation("Blocked", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn    Task         @relation("Blocker", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([organizationId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

enum TaskEventType {
  CREATED
  UPDATED
  DELETED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
  COMMENT_ADDED
}

// Append-only history of a task. `changes` says what this event changed, `snapshot` holds the
// tracked fields as they were right after it, so any two versions can be compared later.
model TaskEvent {
  id             String        @id @default(uuid())
  organizationId String
  taskId         String
  // Null when the system itself acted (e.g. a recurring task being generated).
  actorId        String?
  type           TaskEventType
  changes        Json
  snapshot       Json
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([organizationId])
  @@map("task_events")
}

// Template that produces a new task each time its recurrence rule fires.
model RecurringTask {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  labels         String[]     @default([])
  assigneeId     String?
  createdById    String
  // RFC 5545 rule without DTSTART, e.g. "FREQ=WEEKLY;BYDAY=MO". Times are UTC.
  rrule          String
  startsAt       DateTime
  // Generated tasks are due this many days after the occurrence; null means no due date.
  dueInDays      Int?
  active         Boolean      @default(true)
  // The next occurrence that has not produced a task yet; null once the rule is exhausted.
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("RecurringAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("RecurringCreator", fields: [createdById], references: [id], onDelete: Restrict)
  generated    Task[]

  @@index([organizationId])
  @@index([active, nextRunAt])
  @@map("recurring_tasks")
}

// A comment on a task. Mentions are written into the text as @[Name](userId); they are parsed when
// the comment is saved, not stored separately. Deleting is soft, like tasks.
model Comment {
  id             String    @id @default(uuid())
  organizationId String
  taskId         String
  authorId       String
  body           String
  createdAt      DateTime  @default(now())
  // Set when the text was changed after it was posted.
  editedAt       DateTime?
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author        User           @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([taskId, createdAt])
  @@index([organizationId])
  @@map("comments")
}

enum NotificationType {
  MENTION
  ASSIGNED
}

// Something that happened which one user should know about. `userId` is the recipient.
model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType
  actorId        String
  taskId         String
  commentId      String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment      Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, readAt])
  @@index([userId, organizationId, createdAt])
  @@map("notifications")
}
