# Copy this file to .env and adjust. Never commit .env.

# docker compose
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexora

# api
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://nexora:change-me@localhost:5433/nexora
REDIS_URL=redis://localhost:6380

# auth: generate a secret with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# email (Mailpit in development: http://localhost:8025)
APP_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=NEXORA <no-reply@nexora.test>

# Google sign-in (optional). Create an OAuth client in Google Cloud Console (type: Web application)
# with this redirect URI: http://localhost:3001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background jobs (BullMQ). All queue keys in Redis start with this prefix.
QUEUE_PREFIX=nexora
# Set to false on servers that must not add the every-minute recurring-task job.
QUEUE_SCHEDULER_ENABLED=true

# Number of reverse proxies in front of the API (0 = none). Used to find the client IP.
TRUST_PROXY=0

# Seconds a computed analytics dashboard is kept in Redis (0 = no cache).
ANALYTICS_CACHE_TTL_SECONDS=300

# Bearer token for GET /api/metrics (Prometheus). Empty = the endpoint is off (404).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
METRICS_TOKEN=

# Object storage for file attachments (docker compose runs SeaweedFS with these keys).
# In production use your S3 provider's endpoint, bucket and a key that can only touch that bucket.
S3_ENDPOINT=http://localhost:8333
# Address browsers use for upload/download links; defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=nexora
S3_ACCESS_KEY_ID=nexora-dev
S3_SECRET_ACCESS_KEY=change-me-too
